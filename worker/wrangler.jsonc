{
  "name": "support-note",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "support-note",
      "database_id": "1741eadc-bdcf-49b7-be99-b2c1dab75f39",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "ATT", "bucket_name": "support-note-att" }]
}
